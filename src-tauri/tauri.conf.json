{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "assamese-ime",
  "version": "0.1.0",
  "identifier": "com.dnsip.assamese-ime",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Assamese IME",
        "width": 460,
        "height": 46,
        "resizable": true,
        "fullscreen": false,
        "maximized": false,
        "focusable": false,
        "decorations": false,
        "alwaysOnTop": true,
        "transparent": true,
        "x": 500,
        "y": 0    
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
